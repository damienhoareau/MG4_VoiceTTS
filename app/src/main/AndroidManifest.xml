<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="7"
    android:versionName="1.4.2.21"
    android:compileSdkVersion="29"
    android:compileSdkVersionCodename="10"
    coreApp="true"
    package="com.saicmotor.voicetts"
    platformBuildVersionCode="29"
    platformBuildVersionName="10">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.get.system.info"/>
    <!-- WRITE/READ_EXTERNAL_STORAGE retires : ne servaient qu'aux ressources de
         l'ancien moteur iFlytek (stockage externe du vehicule). La synthese passe
         maintenant par sherpa-onnx + voix Piper embarque directement (voir
         docs/TTS_ENGINE.md), plus par l'ancien moteur iFlytek/Nuance.
         INTERNET utilise par VoiceDownloader (ecran de reglages de MainActivity,
         telechargement optionnel d'une voix alternative), la voix par defaut
         restant embarquee en asset : jamais besoin de reseau pour fonctionner. -->

    <application
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity android:name="com.saicmotor.voicetts.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Permet a Parametres > Synthese vocale d'ouvrir cet ecran pour
                 configurer la voix quand cette app est choisie comme moteur
                 par defaut (voir res/xml/tts_engine.xml). -->
            <intent-filter>
                <action android:name="android.speech.tts.engine.CONFIGURE_ENGINE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <service
            android:name="com.saicmotor.voicetts.TtsService"
            android:enabled="true"
            android:exported="true"/>

        <!-- Moteur TTS systeme standard, voir docs/TTS_ENGINE.md et
             SherpaTextToSpeechService. Selectionnable dans Parametres >
             Synthese vocale > Moteur prefere, independamment du service AIDL
             ITtsService ci-dessus (que la voiture utilise deja). -->
        <service
            android:name="com.saicmotor.voicetts.sherpa.SherpaTextToSpeechService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine"/>
        </service>
        <activity
            android:name="com.saicmotor.voicetts.sherpa.GetSampleTextActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity
            android:name="com.saicmotor.voicetts.sherpa.CheckVoiceDataActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity
            android:name="com.saicmotor.voicetts.sherpa.InstallVoiceDataActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
